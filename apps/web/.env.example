# All optional. src/auth/msalConfig.ts carries working defaults for the app registrations
# created by infra/terraform/identity, so `npm run dev` needs no setup at all.
#
# None of these are secrets. A SPA is a public client: everything it ships is readable in
# devtools, which is exactly why the flow uses PKCE rather than a client secret.

# VITE_API_BASE_URL=http://localhost:5199
# VITE_ENTRA_CLIENT_ID=b209f376-d96a-4b22-aa37-ad9333532998
# VITE_ENTRA_API_CLIENT_ID=817d2b95-0ccf-4245-a431-6141e8370be7
# VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common

# Must match a registered redirect URI byte for byte, trailing slash included.
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173/
