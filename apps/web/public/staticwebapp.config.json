{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{svg,png,ico,webmanifest}"]
  },

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },

  "mimeTypes": {
    ".json": "application/json",
    ".svg": "image/svg+xml"
  }
}
